APP_NAME="Gráfica Yuri"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Luanda
APP_URL=http://localhost:8000
APP_LOCALE=pt

# --- Base de dados (versão local recomendada: MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grafica_yuri
DB_USERNAME=root
DB_PASSWORD=
# Para Neon/Supabase, use pgsql e SSL.
# DB_CONNECTION=pgsql
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

FILESYSTEM_DISK=public

# Em produção, use um bucket S3/R2/Supabase Storage para não perder uploads.
PUBLIC_FILESYSTEM_DRIVER=local
PUBLIC_FILESYSTEM_URL=${APP_URL}/storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=log
